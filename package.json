{
  "name": "@twake/tom-bridge",
  "description": "A Twake Workplace Matrix Application Service automating user management based on TWP Events",
  "version": "1.0.2",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "license": "AGPL-3.0-or-later",
  "repository": "github:linagora/tom-bridge",
  "homepage": "https://github.com/linagora/tom-bridge?tab=readme-ov-file",
  "bugs": {
    "url": "https://github.com/linagora/tom-bridge/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch ./src/index.ts",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/sqlite3": "^5.1.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.7.2",
    "@linagora/twake-node-server": "^1.0.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "matrix-appservice-bridge": "12.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.3"
  },
  "allowScripts": {
    "@matrix-org/matrix-sdk-crypto-nodejs": true,
    "sqlite3": true,
    "esbuild": true
  }
}
