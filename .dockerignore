# =============================================================================
# Docker Build Context Exclusions
# Only include files necessary for building the application
# =============================================================================
**/*
*

## Allow package definition files
!package.json
!package-lock.json

## Allow build configuration files
!tsconfig.json
!tsconfig.build.json

## Allow source files
!src/**

## Ensure test files are not imported
src/__mocks__/
src/**/*.test.ts
